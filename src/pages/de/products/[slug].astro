---
import ProductView from '../../../views/ProductView.astro';
import { getProducts, type Product } from '../../../lib/products';

/** One page per product, per language. Adding a JSON file adds two pages. */
export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<ProductView product={product} locale="de" />
