---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProducts, statusLabel } from '../lib/products';
import { CONTACT_EMAIL } from '../lib/site';

const products = await getProducts();
---

<BaseLayout
  title="Support"
  description="Get help with an LCR Labs application: where to write, and what to include so a problem can be reproduced."
>
  <section class="section">
    <div class="container">
      <header class="head">
        <p class="eyebrow">Support</p>
        <h1>Getting help</h1>
        <p class="lede">
          Product questions, bug reports and feature suggestions all go to the same place.
        </p>
      </header>

      <div class="prose">
        <h2>Contacting LCR Labs</h2>
        <p>
          Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. It is a person
          reading, not a ticket system, so plain prose is fine.
        </p>

        <h2>What to include in a bug report</h2>
        <p>Four things make a report something that can actually be acted on:</p>
        <ul>
          <li>The app and its version number.</li>
          <li>Your macOS version.</li>
          <li>What you expected to happen, and what happened instead.</li>
          <li>The steps that reproduce it, in the order you took them.</li>
        </ul>
        <p>
          The steps matter most. A problem that can be reproduced is usually a problem that
          can be fixed; one that cannot be reproduced rarely is.
        </p>

        <h2>Per-product notes</h2>
        <ul>
          {
            products.map((product) => (
              <li>
                <a href={`/products/${product.id}/`}>{product.data.name}</a> —{' '}
                {product.data.statusNote ?? `${statusLabel(product)}.`}
              </li>
            ))
          }
        </ul>

        <h2>Privacy</h2>
        <p>
          What each app does with your data is described on its product page, and this
          website’s own data handling is described in the <a href="/privacy/">privacy notice</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    max-width: var(--content-narrow);
    margin-bottom: var(--space-10);
  }

  .head h1 {
    margin-top: var(--space-3);
  }

  .head .lede {
    margin-top: var(--space-4);
  }
</style>
