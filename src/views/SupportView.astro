---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProducts, content, productHref, statusLabel } from '../lib/products';
import { CONTACT_EMAIL } from '../lib/site';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const products = await getProducts();

/* Each product's own sentence where it has one, and its status otherwise —
   in this page's language, like everything else on it. */
const notes = products.map((product) => ({
  name: product.data.name,
  href: productHref(product, locale),
  note: content(product, locale).statusNote ?? `${statusLabel(product, locale)}.`,
}));
---

<BaseLayout locale={locale} title={t.support.title} description={t.support.description}>
  <section class="section">
    <div class="container">
      <header class="head">
        <p class="eyebrow">{t.support.eyebrow}</p>
        <h1>{t.support.heading}</h1>
        <p class="lede">{t.support.lede}</p>
      </header>

      <div class="prose">
        <h2>{t.support.contactHeading}</h2>
        <p>
          {t.support.contactBefore}<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a
          >{t.support.contactAfter}
        </p>

        <h2>{t.support.reportHeading}</h2>
        <p>{t.support.reportIntro}</p>
        <ul>
          {t.support.reportItems.map((item) => <li>{item}</li>)}
        </ul>
        <p>{t.support.reportOutro}</p>

        <h2>{t.support.perProductHeading}</h2>
        <ul>
          {
            notes.map((product) => (
              <li>
                <a href={product.href}>{product.name}</a> — {product.note}
              </li>
            ))
          }
        </ul>

        <h2>{t.support.privacyHeading}</h2>
        <p>
          {t.support.privacyBefore}<a href={localePath('/privacy/', locale)}
            >{t.support.privacyLink}</a
          >{t.support.privacyAfter}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    max-width: var(--content-narrow);
    margin-bottom: var(--space-10);
  }

  .head h1 {
    margin-top: var(--space-3);
  }

  .head .lede {
    margin-top: var(--space-4);
  }
</style>
