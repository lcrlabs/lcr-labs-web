---
import Button from './Button.astro';
import type { Product } from '../lib/products';
import { hasSetappDestination, setappHref } from '../lib/products';

/**
 * The Setapp call to action.
 *
 * This is the only place in the site that can produce an outbound commercial
 * link, and it produces one only when the product's own data supplies a real
 * destination. With no configured URL the reader gets an honest sentence about
 * availability rather than a button that goes nowhere — never a "Buy",
 * "Download" or checkout affordance, because LCR Labs sells nothing itself.
 */
interface Props {
  product: Product;
  size?: 'md' | 'lg';
  /** Show the informational Single-App price beside the action, if configured. */
  showPrice?: boolean;
}

const { product, size = 'md', showPrice = false } = Astro.props;

const href = setappHref(product);
const linkable = hasSetappDestination(product);
const { priceLabel } = product.data.setapp;

const unavailableNote =
  product.data.status === 'coming-soon'
    ? 'Not yet released.'
    : 'Availability is being finalised.';
---

{
  linkable ? (
    <div class="setapp">
      <Button href={href!} variant="primary" size={size} external>
        View on Setapp
      </Button>
      {showPrice && priceLabel && (
        <p class="setapp__price">
          {priceLabel} on Setapp. Purchase and licensing are handled by Setapp.
        </p>
      )}
    </div>
  ) : (
    <p class="setapp__note">{product.data.statusNote ?? unavailableNote}</p>
  )
}

<style>
  .setapp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .setapp__price,
  .setapp__note {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
</style>
