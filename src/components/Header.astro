---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS } from '../lib/site';

/**
 * Site header.
 *
 * The compact-width menu is a native <details> disclosure: it opens, closes
 * and takes keyboard focus correctly with no JavaScript at all. The small
 * script below only adds the two conveniences the element does not provide —
 * closing on Escape and on a click outside.
 */
const path = Astro.url.pathname;

/** `/products/` should also read as current on `/products/edgehold/`. */
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/" aria-label="LCR Labs — home">
      <Logo size={24} />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul class="header__list">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a
                class="header__link"
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <ThemeToggle />
      <a class="header__cta" href="/products/">Explore Apps</a>

      <details class="menu" data-menu>
        <summary class="menu__button" aria-label="Menu">
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path
              d="M3 6h14M3 10h14M3 14h14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </summary>
        <nav class="menu__panel" aria-label="Main">
          <ul>
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    /* A macOS-toolbar treatment: mostly opaque, a little translucency. */
    background-color: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .header {
      background-color: var(--bg);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    height: var(--header-height);
  }

  .header__brand {
    flex: none;
    display: inline-flex;
    border-radius: var(--radius-sm);
  }

  .header__nav {
    display: none;
    flex: 1;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--text-secondary);
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .header__link:hover {
    color: var(--text-primary);
    background-color: var(--surface-hover);
  }

  .header__link[aria-current='page'] {
    color: var(--text-primary);
    font-weight: 500;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
  }

  .header__cta {
    display: none;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
    transition: background-color var(--duration-fast) var(--ease);
  }

  .header__cta:hover {
    background-color: var(--surface-hover);
  }

  /* ---- Compact-width menu ---- */

  .menu {
    position: relative;
  }

  .menu__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .menu__button::-webkit-details-marker {
    display: none;
  }

  .menu__button:hover {
    background-color: var(--surface-hover);
    color: var(--text-primary);
  }

  .menu__panel {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    min-width: 190px;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    box-shadow: var(--shadow-md);
  }

  .menu__panel a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  .menu__panel a:hover {
    background-color: var(--surface-hover);
    color: var(--text-primary);
  }

  .menu__panel a[aria-current='page'] {
    color: var(--text-primary);
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .header__nav,
    .header__cta {
      display: block;
    }

    .menu {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const menu = document.querySelector('[data-menu]');
    if (!menu) return;

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
  })();
</script>
