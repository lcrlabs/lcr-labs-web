---
import type { Product } from '../lib/products';

/**
 * A product's visual anchor, framed consistently across products.
 *
 * Until a real screenshot exists the frame renders empty rather than showing
 * an invented mockup of an interface that may not look like that. Dropping a
 * screenshot into the product's JSON replaces it with no markup change.
 */
interface Props {
  product: Product;
  /** Index into the product's screenshots. */
  index?: number;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { product, index = 0, loading = 'lazy', class: className } = Astro.props;
const shot = product.data.screenshots[index];
---

<figure class:list={['visual', className]}>
  <div class="visual__frame">
    {
      shot ? (
        <img src={shot.src} alt={shot.alt} loading={loading} decoding="async" />
      ) : (
        <div class="visual__empty">
          <span class="visual__watermark" aria-hidden="true" />
          <span class="visual__label">Screenshots to follow</span>
        </div>
      )
    }
  </div>
</figure>

<style>
  .visual {
    margin: 0;
  }

  .visual__frame {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface-sunken);
    box-shadow: var(--shadow-md);
  }

  .visual__frame img {
    width: 100%;
  }

  .visual__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    aspect-ratio: 16 / 10;
    /* Keeps the placeholder from opening a huge void at full page width.
       A real screenshot is unaffected — this styles the empty state only. */
    max-height: 360px;
  }

  .visual__watermark {
    width: 96px;
    height: 52px;
    background-color: var(--text-primary);
    opacity: 0.06;
    mask-image: url('/brand/lcr-mark.png');
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
  }

  .visual__label {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }
</style>
