---
import type { Product } from '../lib/products';

/**
 * A reserved product slot.
 *
 * Used for a product whose name and scope are not yet confirmed. It is
 * deliberately quieter than a real product row and carries no call to action,
 * so an unannounced product is never given invented copy, an invented name or
 * a link that goes nowhere. Flipping `placeholder` to false in the product's
 * JSON promotes it to a full row with no code change.
 */
interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="slot">
  <span class="slot__mark" aria-hidden="true"></span>
  <div>
    <h3 class="slot__name">{product.data.name}</h3>
    <p class="slot__text">{product.data.longDescription}</p>
  </div>
</article>

<style>
  .slot {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background-color: var(--bg-subtle);
  }

  .slot__mark {
    flex: none;
    width: 52px;
    height: 28px;
    background-color: var(--text-primary);
    opacity: 0.14;
    mask-image: url('/brand/lcr-mark.png');
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;
  }

  .slot__name {
    font-size: var(--text-md);
    color: var(--text-secondary);
  }

  .slot__text {
    margin-top: var(--space-1);
    max-width: 60ch;
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
</style>
