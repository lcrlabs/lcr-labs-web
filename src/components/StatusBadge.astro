---
import type { Product } from '../lib/products';
import { statusLabel } from '../lib/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const status = product.data.status;
---

<span class:list={['badge', `badge--${status}`]}>
  <span class="badge__dot" aria-hidden="true"></span>
  {statusLabel(product)}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2rem 0.55rem 0.2rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
  }

  /* Status colour carries meaning; the brand accent stays out of it. The
     scale runs from shipped to speculative, and the dot gets quieter as the
     product gets further from release. */
  .badge--available .badge__dot {
    background-color: var(--success);
  }

  .badge--beta .badge__dot {
    background-color: var(--warning);
  }

  .badge--coming-soon .badge__dot,
  .badge--in-development .badge__dot {
    background-color: var(--info);
  }

  .badge--in-planning .badge__dot {
    background-color: var(--text-tertiary);
  }
</style>
