---
import type { Product } from '../lib/products';
import { useTranslations, type Locale } from '../i18n';
interface Props { product: Product; locale: Locale; }
const { product, locale } = Astro.props;
const t = useTranslations(locale);
const url = product.data.status === 'available' ? product.data.appStoreUrl : undefined;
---

{url && (
  <a class="store-button" href={url} aria-label={`${product.data.name} — ${t.product.appStoreAction} Mac App Store`}>
    <svg class="store-button__icon" width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M14 4v13m-5-5 5 5 5-5M5 18v5h18v-5" />
    </svg>
    <span class="store-button__copy">
      <span class="store-button__eyebrow">{t.product.appStoreAction}</span>
      <span class="store-button__title">Mac App Store</span>
    </span>
  </a>
)}

<style>
  .store-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--text-primary);
    color: var(--bg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease);
  }
  .store-button:hover { opacity: 0.85; }
  .store-button__icon { flex: none; }
  .store-button__copy { display: grid; text-align: left; gap: var(--space-1); }
  .store-button__eyebrow { font-size: var(--text-xs); line-height: var(--leading-tight); }
  .store-button__title { font-size: var(--text-lg); font-weight: 600; line-height: var(--leading-tight); letter-spacing: -0.02em; }
</style>
