---
import type { Product } from '../lib/products';
import { content } from '../lib/products';
import type { Locale } from '../i18n';

/**
 * The one honest sentence about a product's availability.
 *
 * The site sells and delivers nothing, so this is all a not-yet-released
 * product gets: no button that goes nowhere, and no invented release date.
 */
interface Props {
  product: Product;
  locale: Locale;
}

const { product, locale } = Astro.props;
const statusNote = content(product, locale).statusNote;
---

{statusNote && <p class="status-note">{statusNote}</p>}

<style>
  .status-note {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }
</style>
